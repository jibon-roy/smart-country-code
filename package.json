{
  "name": "smart-country-code",
  "version": "1.0.0",
  "description": "A lightweight utility package providing an extensive list of country codes (ISO 3166-1 alpha-2, alpha-3, and numeric codes) along with country names for smart lookups, mapping, and validation in Node.js or browser environments.",
  "keywords": [
    "smart-country-code",
    "country-code",
    "iso-country",
    "country-codes",
    "country-code-npm",
    "country",
    "typescript",
    "javascript",
    "utility",
    "npm"
  ],
  "license": "MIT",
  "author": "Jibon Krishna Roy",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepare": "npm run build",
    "watch": "jest --watch",
    "lint": "eslint . --ext .ts,.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "typescript": "^4.9.5"
  }
}
